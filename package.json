{
  "name": "traceguard",
  "version": "0.1.0",
  "description": "Catch breaking API changes before they reach production.",
  "type": "module",
  "bin": {
    "traceguard": "./dist/cli/index.js"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20.18.0"
  },
  "scripts": {
    "start": "node ./dist/cli/index.js --help",
    "demo": "node ./dist/cli/index.js diff fixtures/central-example/spec-v1.yaml fixtures/central-example/spec-v2.yaml",
    "live": "node ./scripts/run-live.mjs",
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src tests",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "openapi",
    "api-testing",
    "breaking-changes",
    "contract-testing",
    "spec-diff",
    "ci"
  ],
  "author": "Arnav",
  "license": "MIT",
  "dependencies": {
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "commander": "^13.1.0",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.1",
    "@vitest/coverage-v8": "^3.0.5",
    "eslint": "^9.20.1",
    "tsup": "^8.4.0",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.24.0",
    "vitest": "^3.0.5"
  }
}
